---
<ul class="flex gap-5">
  {socials.map((s) => (
    <li>
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={s.label}
        class="inline-block text-light-slate hover:text-accent transition-colors"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d={iconPaths[s.icon]} />
        </svg>
      </a>
    </li>
  ))}
</ul>
