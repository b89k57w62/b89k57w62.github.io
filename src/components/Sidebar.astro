---
import type { Profile } from '../data/types';
import SocialLinks from './SocialLinks.astro';
import LanguageToggle from './LanguageToggle.astro';
interface Props { lang: 'zh' | 'en'; profile: Profile }
const { lang, profile } = Astro.props;
---
<header class="lg:sticky lg:top-0 lg:h-screen lg:w-[45%] lg:py-24 flex flex-col justify-between py-12">
  <div>
    <LanguageToggle lang={lang} />
    <h1 class="mt-6 text-4xl font-bold text-lightest-slate">{profile.name}</h1>
    <h2 class="mt-3 text-lg text-light-slate">{profile.title}</h2>
    <div class="mt-8">
      <slot name="nav" />
    </div>
  </div>
  <div class="mt-8">
    <SocialLinks socials={profile.socials} />
  </div>
</header>
