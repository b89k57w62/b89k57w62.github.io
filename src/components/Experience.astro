---
import type { Profile } from '../data/types';
interface Props { profile: Profile; heading: string }
const { profile, heading } = Astro.props;
---
<section id="experience" aria-label={heading}>
  <h2 class="mb-4 text-sm font-mono uppercase tracking-widest text-lightest-slate">{heading}</h2>
  <ol class="space-y-6">
    {profile.experience.map((e) => (
      <li class="grid gap-2 sm:grid-cols-[8rem_1fr]">
        <span class="text-sm font-mono text-slate">{e.period}</span>
        <div>
          <h3 class="text-lightest-slate">{e.role} · <span class="text-light-slate">{e.org}</span></h3>
          <p class="mt-1 text-sm text-slate">{e.summary}</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {e.tags.map((tg) => (
              <li class="rounded bg-white/5 px-2 py-0.5 text-xs font-mono text-accent">{tg}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>
