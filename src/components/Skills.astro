---
import type { Profile } from '../data/types';
interface Props { profile: Profile; heading: string }
const { profile, heading } = Astro.props;
---
<section id="skills" aria-label={heading}>
  <h2 class="mb-4 text-sm font-mono uppercase tracking-widest text-lightest-slate">{heading}</h2>
  <div class="space-y-4">
    {profile.skills.map((g) => (
      <div>
        <h3 class="mb-2 text-light-slate">{g.group}</h3>
        <ul class="flex flex-wrap gap-2">
          {g.items.map((i) => (
            <li class="rounded bg-white/5 px-3 py-1 text-sm font-mono text-accent">{i}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
